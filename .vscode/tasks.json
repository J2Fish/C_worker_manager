{
    "tasks": [
        {
            "type": "shell",
            "label": "build-all-cpp",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-finput-charset=UTF-8",
                "-fexec-charset=UTF-8",
                "-std=c++20",
                "-g",
                "${workspaceFolder}\\test.cpp",
                "${workspaceFolder}\\command.cpp",
                "${workspaceFolder}\\fileio.cpp",
                "${workspaceFolder}\\worker.cpp",
                "-o",
                "${workspaceFolder}\\test.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "TMP": "D:\\Temp\\CPP",
                    "TEMP": "D:\\Temp\\CPP",
                    "TMPDIR": "D:\\Temp\\CPP"
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "type": "cppbuild",
            "label": "C/C++: g++.exe build active file",
            "command": "C:\\msys64\\ucrt64\\bin\\g++.exe",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ],
    "version": "2.0.0"
}